__pycache__/
*.pyc
.pytest_cache/
.env
*.egg-info/
events.jsonl
.DS_Store

# Run outputs stay untracked by default. The exceptions are the small result
# summaries that back claims in the README, committed as evidence. Transcripts
# and logs are never committed: they are large and regenerable.
runs/*
!runs/h1/
runs/h1/*
!runs/h1/*.json
runs/h1/*transcripts*.json
!runs/lex/
runs/lex/*
!runs/lex/*.json
runs/lex/*transcripts*.json
!runs/skill_lift.json
!runs/skill_lift_live.json
!runs/probe_coverage.json
# The sweep artifacts the figures are built from. figures.py claims to
# regenerate 'from committed artifacts'; without these a clean clone
# silently produces fewer figures than the paper cites, with no error.
!runs/v2_k.json
!runs/v2_budget.json
!runs/ratchet.json
!runs/sufficiency.json
!runs/LICENSE-DATA

# The event logs behind the headline deterministic claims ARE committed. The
# README says every metric is a pure fold over an append-only log and that
# results can be recomputed from the log alone; a reader cannot check that
# against a log that is not in the repository. They are gzipped, normalised
# (wall-clock stripped) and byte-stable, and `python -m paper.export_log`
# regenerates them AND folds them back to verify the claim holds.
!runs/logs/
!runs/logs/*.jsonl.gz
